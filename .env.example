# Firebase web config for Kyauk Thin Bone (/kyauk-thin-bone/).
# Copy to .env.local for local dev. For the GitHub Pages build, add the same
# names as repository variables (Settings → Secrets and variables → Actions → Variables).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: point at local emulators (`firebase emulators:start --only database,auth`).
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
