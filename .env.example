# Firebase web config, shared by Analytics (every page) and the /apps/ mini apps
# (whosthefirst, kyauk-thin-bone).
# Copy to .env.local for dev.
# In CI these come from GitHub repository variables (Settings → Secrets and
# variables → Actions → Variables). The web config is public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Analytics runs only when this is set too (Firebase console → Project settings → your web app).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local testing against `npx firebase-tools emulators:start` only.
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
